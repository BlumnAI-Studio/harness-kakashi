{
  "$schema": "kakashi-harness",
  "$schemaVersion": "1.0.0",
  "name": "Kakashi's Harness",
  "description": "카카시 하네스 이용기록기(테스트겸)",
  "version": "1.6.0",
  "agents": [
    "tamer",
    "performance-scout",
    "test-sentinel",
    "security-guard",
    "build-doctor",
    "code-modernizer",
    "akka-net-specialist",
    "dotnet-concurrency-specialist",
    "dotnet-performance-analyst",
    "dotnet-benchmark-designer",
    "docfx-specialist",
    "roslyn-incremental-generator-specialist",
    "sage-deming",
    "hoshimori",
    "chizumori"
  ],
  "engine": [
    "toad-summoning"
  ],
  "evaluation": {
    "base": {
      "agent": "sage-deming",
      "doctrine": "PDSA",
      "alwaysOn": true,
      "appliesTo": ["mode-a", "execution"],
      "exemptModes": ["mode-d-init", "tutorial"]
    },
    "followUp": {
      "trigger": "domain-match",
      "mappingDoc": "harness/knowledge/methodology/evaluation-base-pdsa.md"
    }
  },
  "keepers": {
    "hoshimori": {
      "alwaysOn": true,
      "scope": ["README.md", "README-EN.md", "harness/**/*.md", "docs/**/*.md"],
      "exclude": ["plugins/**", "tmp/**", ".claude/**", "node_modules/**", "prompt/**"],
      "trigger": "doc-change",
      "doctrineDoc": "harness/knowledge/methodology/zettelkasten-llm-era.md"
    },
    "chizumori": {
      "alwaysOn": false,
      "viewRoot": "Home/harness-view",
      "scope": ["harness/**/*.md", "docs/**/*.md", "README.md", "README-EN.md"],
      "exclude": ["plugins/**", "tmp/**", ".claude/**", "node_modules/**", "prompt/**", "Home/harness-view/indexes/**", "Home/harness-view/data/pdsa-insight.json"],
      "syncTrigger": "manual-or-pre-publish",
      "publishTrigger": "tag:doc-v* | workflow_dispatch",
      "deployTarget": "github-pages",
      "principles": "static-as-reference, dynamic-in-sync"
    }
  },
  "created": "2026-04-19",
  "lastUpdated": "2026-05-08",
  "plugins": {
    "harness-kakashi": {
      "skills": ["harness-kakashi-creator", "harness-chakra-kakashi"]
    }
  }
}
